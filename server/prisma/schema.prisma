// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String       @id @default(uuid())
  email     String       @unique
  userId    String?      @unique
  name      String
  password  String
  createdAt DateTime     @default(now())
  sessions  Session[]
  avatar    Avatar?
  friend1   Friend[]     @relation("FriendshipUser1")
  friend2   Friend[]     @relation("FriendshipUser2")
  summary   UserSummary?
  conversation Conversations[]
}

model Session {
  sessionId String     @id @default(uuid())
  userPK    String
  user      User       @relation(fields: [userPK], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime   @default(now())
}

model Avatar {
  user      User       @relation(fields: [userPK], references: [id], onDelete: Cascade)
  userPK    String     @id
  key       String     @unique
  createdAt DateTime   @default(now())
}

model Friend {
  user1     User      @relation("FriendshipUser1", fields: [initiator], references: [userId], onDelete: Cascade)
  user2     User      @relation("FriendshipUser2", fields: [friendId], references: [userId], onDelete: Cascade)
  initiator   String
  friendId   String
  state     String
  @@id([initiator,friendId])
}

model UserSummary {
  userPK           String   @id
  friendId         String[]
  newFriendRequest Boolean  @default(false)
  user User @relation(fields: [userPK], references: [id], onDelete: Cascade)
}

model Conversations {
  userPK           String   
  friendPK         String
  friendName       String
  lastMessage      String
  lastMessageDate  DateTime
  user User @relation(fields: [userPK], references: [id], onDelete: Cascade)
  @@id([userPK,friendPK])
}