// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  email     String   @unique
  userId    String?   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  sessions  Session[]
  avatarKey String? @unique
}

model Session {
  sessionId String     @id @default(uuid())
  userPK    String
  user      User       @relation(fields: [userPK], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime   @default(now())
}